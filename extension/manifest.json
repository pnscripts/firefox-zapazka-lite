{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Zapazka Lite",
  "version": "1.0.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "author": "PN Scripts",
  "homepage_url": "https://pnscripts.com",
  "icons": {
    "48": "icons/zapazka-48.png",
    "96": "icons/zapazka-96.png",
    "128": "icons/zapazka-128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "core.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/zapazka-16.png",
      "32": "icons/zapazka-32.png",
      "48": "icons/zapazka-48.png"
    }
  },
  "background": {
    "scripts": [
      "core.js",
      "background.js"
    ]
  },
  "incognito": "not_allowed",
  "browser_specific_settings": {
    "gecko": {
      "id": "zapazka-lite@pnscripts.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
